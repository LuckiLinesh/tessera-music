# ---------------------------------------------------------------------------
# Tessera catalog - optional provider keys.
# Copy this file to .env.local and fill in only what you have.
# Nothing here is required for the app to boot: a missing key disables that
# source and the Sources page says so.
# ---------------------------------------------------------------------------

# MusicBrainz asks for a descriptive User-Agent with contact details.
# Format: AppName/version ( contact-url-or-email )
MUSICBRAINZ_USER_AGENT="TesseraCatalog/1.0 ( https://github.com/your-handle/tessera )"

# YouTube Data API v3 - https://console.cloud.google.com/apis/credentials
# Enable "YouTube Data API v3", create an API key, then restrict it to that API.
# Free quota: 10,000 units/day. One search.list call costs 100 units.
YOUTUBE_API_KEY=

# Jamendo - https://developer.jamendo.com/
# Register an app to get a client id. Enables full-length CC/Jamendo tracks.
JAMENDO_CLIENT_ID=

# Openverse is off by default: its public endpoint rate-limits and can be
# blocked by Cloudflare. Turn it on only if you have checked it from your host.
ENABLE_OPENVERSE=0

# Optional label sent to Audius. Purely cosmetic.
AUDIUS_APP_NAME=TesseraCatalog
